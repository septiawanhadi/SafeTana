{
    "framework": null,
    "devCommand": "npm run dev",
    "rewrites": [
        {
            "source": "/sitemap-index.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron-poll",
            "schedule": "*/10 * * * *"
        }
    ]
}