{
    "framework": null,
    "devCommand": "npm run dev",
    "rewrites": [
        {
            "source": "/rss.xml",
            "destination": "/api/rss"
        },
        {
            "source": "/sitemap-index.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}